# ─────────────────────────────────────────────────────────────────────────────
# WildfireIQ Kamloops — configuration
# Copy to `.env` if you want to change a default. Do NOT commit `.env`.
#
# There are no API keys in this file. The third-party keys (Cesium Ion, NASA
# FIRMS, WAQI, OpenRouter) are entered in the app: click the key icon in the
# top bar. A visitor's keys stay in their browser; the owner's server keys are
# stored in data/runtime/keys.json (ignored by git).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/wildfireiq.db

# Protects the owner's server keys. Leave empty on a laptop used by one
# person. Before exposing the API to anyone else, set it to a long random
# string; the Settings panel's server section will then ask for it.
ADMIN_TOKEN=
# The origin(s) visitors use, when the web app is served separately from the API.
# CORS_ORIGINS=["https://wildfire.example.ca"]

# Run the cron scheduler in-process. Set to false for CI or tests.
SCHEDULER_ENABLED=true
# On boot, re-run any recurring job whose last success is older than this.
STARTUP_REFRESH_MINUTES=30

# ── Feature flags ────────────────────────────────────────────────────────────
# Section 6 of /climate renders only when this is true AND the campus CSV
# exists at data/tru_carbon.csv (columns: year, tco2e, target).
VITE_ENABLE_TRU_CARBON=false

# ── Assistant tuning (the key itself is entered in the app) ──────────────────
ASSISTANT_ENABLED=true
# Model to route to. GLM 5.3 Flash is the default: tool calling, a 1.3M-token
# context, and a measured $0.0013 per answer across the 32-case eval suite.
ASSISTANT_MODEL=z-ai/glm-5.3-flash
# Budget ceilings per question.
ASSISTANT_MAX_STEPS=5
ASSISTANT_MAX_TOOL_CALLS=12
# GLM 5.3 Flash reasons before answering, and OpenRouter reserves that
# allowance before the reply is written. "low" holds the eval suite at 32/32
# while cutting median latency from 16 s to 6 s. "none" | "low" | "medium" | "high".
ASSISTANT_REASONING_EFFORT=low
ASSISTANT_MAX_OUTPUT_TOKENS=3000

# Abuse + spend limits. This is the only endpoint that costs money and the
# app has no accounts, so these are the access control.
ASSISTANT_RATE_PER_MINUTE=4
ASSISTANT_RATE_PER_HOUR=30
ASSISTANT_MAX_CONCURRENT=4
ASSISTANT_DAILY_COST_LIMIT_USD=2.0
